# ==========================================
# Page Pulse - Server Environment Variables
# ==========================================

# Server
NODE_ENV=development
PORT=5000

# CORS - comma separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# Redis (leave blank to fall back to in-memory cache adapter)
REDIS_URL=redis://localhost:6379

# Cache
CACHE_TTL_SECONDS=300

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Audit engine
AUDIT_TIMEOUT_MS=5000
AUDIT_MAX_CONCURRENCY=10
AUDIT_MAX_REDIRECTS=5

# Logging
LOG_LEVEL=info
